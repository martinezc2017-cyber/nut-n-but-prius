{
  // Nut N But Prius — the site on nutnbutprius.com (domain registered in this same Cloudflare account, 24 nov 2026).
  // The files at the repo root are the site (GitHub Pages serves the same ones as a preview that forwards here).
  "name": "nutnbutprius",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // the Worker goes first only to send www → nutnbutprius.com
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "nutnbutprius.com", "custom_domain": true },
    { "pattern": "www.nutnbutprius.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Booking by email (25 nov): the Worker mails the request to the secret BOOKING_TO (a verified Email Routing address;
  // free on every plan for verified destinations). EMAIL_BOOKING "on" shows the option on the page.
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "EMAIL_BOOKING": "on" },
  // at most 5 booking emails per minute from one visitor
  "ratelimits": [{ "name": "BOOK_LIMIT", "namespace_id": "2511", "simple": { "limit": 5, "period": 60 } }],
  // the shop's bookings and counters (schema in db/schema.sql); the owner sees them at /shop (password: secret SHOP_PASSWORD)
  "d1_databases": [{ "binding": "DB", "database_name": "nutnbutprius", "database_id": "919b6686-19cd-49f8-9bf2-97b06ca72c62" }],
  // 15:00 UTC = 8 AM Arizona (no daylight saving there): the day's bookings to the owner's email
  "triggers": { "crons": ["0 15 * * *"] }
}
